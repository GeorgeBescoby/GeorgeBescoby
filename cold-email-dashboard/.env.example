# Copy to .env and fill in. Never commit .env.

# Password for the dashboard (shared with the CEO).
DASHBOARD_PASSWORD=change-me
# Optional: separate secret for signing the login cookie (defaults to the password).
SESSION_SECRET=

# mock = sample data, live = Smartlead. The toggle on the Settings page overrides this.
DATA_MODE=mock

# Smartlead API key (Settings -> API Key in Smartlead). Server-side only.
SMARTLEAD_API_KEY=

# Secret for the daily sync endpoint: /api/cron/sync (send as "Authorization: Bearer <secret>").
CRON_SECRET=
# Secret in the Smartlead webhook URL: /api/webhooks/smartlead?token=<secret>
WEBHOOK_SECRET=

# Database. Local file by default; on Railway point it at the volume, e.g. file:/data/dashboard.db.
# For Turso: libsql://<db>.turso.io plus DATABASE_AUTH_TOKEN.
DATABASE_URL=file:./data/dashboard.db
DATABASE_AUTH_TOKEN=
